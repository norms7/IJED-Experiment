CREATE OR REPLACE FUNCTION public._student_attendance_rows(p_student_id integer)
 RETURNS TABLE(subject_id integer, subject_name character varying, class_id integer, class_name character varying, term character varying, session_date date, status character varying)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  select
    ats.subject_id,
    coalesce(sub.name, 'General / Homeroom') as subject_name,
    ats.class_id,
    cls.name as class_name,
    ats.term,
    ats.session_date,
    ar.status
  from attendance_records ar
  join attendance_sessions ats on ats.id = ar.session_id
  join classes cls on cls.id = ats.class_id
  left join subjects sub on sub.id = ats.subject_id
  where ar.student_id = p_student_id
    and ats.has_class = true;
$function$

CREATE OR REPLACE FUNCTION public.get_beta_binomial_evidence(p_student_id integer, p_subject_ids integer[], p_target_pct numeric, p_term character varying DEFAULT NULL::character varying)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_caller_student_id integer := auth_student_id();
  v_subject_ids integer[];
  v_my_successes integer;
  v_my_failures integer;
  v_peer_successes integer;
  v_peer_failures integer;
begin
  if not is_admin() and (v_caller_student_id is null or v_caller_student_id <> p_student_id) then
    raise exception 'Not authorized' using errcode = '42501';
  end if;

  if p_subject_ids is not null then
    v_subject_ids := p_subject_ids;
  else
    select coalesce(array_agg(subject_id), '{}') into v_subject_ids
    from student_subject_enrollments where student_id = p_student_id;
  end if;

  if v_subject_ids = '{}' then
    return jsonb_build_object('my_successes', 0, 'my_failures', 0, 'peer_successes', 0, 'peer_failures', 0);
  end if;

  select
    count(*) filter (where (s.score::numeric / s.max_score) * 100 >= p_target_pct),
    count(*) filter (where (s.score::numeric / s.max_score) * 100 <  p_target_pct)
  into v_my_successes, v_my_failures
  from activity_submissions s
  join activities a on a.id = s.activity_id
  where s.student_id = p_student_id
    and a.subject_id = any(v_subject_ids)
    and a.is_published = true
    and (p_term is null or a.term = p_term)
    and s.is_graded = true and s.score is not null and s.max_score > 0;

  select
    count(*) filter (where (s2.score::numeric / s2.max_score) * 100 >= p_target_pct),
    count(*) filter (where (s2.score::numeric / s2.max_score) * 100 <  p_target_pct)
  into v_peer_successes, v_peer_failures
  from activity_submissions s2
  join activities a2 on a2.id = s2.activity_id
  join student_subject_enrollments sse2
    on sse2.student_id = s2.student_id and sse2.subject_id = a2.subject_id
  where a2.subject_id = any(v_subject_ids)
    and a2.is_published = true
    and (p_term is null or a2.term = p_term)
    and s2.is_graded = true and s2.score is not null and s2.max_score > 0
    and s2.student_id <> p_student_id;

  return jsonb_build_object(
    'my_successes', coalesce(v_my_successes, 0),
    'my_failures', coalesce(v_my_failures, 0),
    'peer_successes', coalesce(v_peer_successes, 0),
    'peer_failures', coalesce(v_peer_failures, 0)
  );
end;
$function$

CREATE OR REPLACE FUNCTION public.get_engagement_percentile(p_student_id integer, p_subject_ids integer[] DEFAULT NULL::integer[], p_term character varying DEFAULT NULL::character varying)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_caller_student_id integer := auth_student_id();
  v_pool integer[];
  v_result jsonb;
begin
  if not is_admin() and (v_caller_student_id is null or v_caller_student_id <> p_student_id) then
    raise exception 'Not authorized' using errcode = '42501';
  end if;

  select array_agg(distinct sid) into v_pool
  from (
    select p_student_id as sid
    union
    select ssa2.student_id
    from student_section_assignments ssa1
    join student_section_assignments ssa2
      on ssa2.section_id = ssa1.section_id and ssa2.student_id <> ssa1.student_id
    join students st on st.id = ssa2.student_id
    join users u on u.id = st.user_id and u.is_active = true
    where ssa1.student_id = p_student_id
      and (p_subject_ids is null or exists (
        select 1 from student_subject_enrollments sse
        where sse.student_id = ssa2.student_id and sse.subject_id = any(p_subject_ids)
      ))
  ) x;

  with scored as (
    select
      pool.id as student_id,
      att.attendance_pct,
      modc.module_pct,
      round(coalesce(att.attendance_pct, 0) * 0.4 + coalesce(modc.module_pct, 0) * 0.6, 2) as engagement_score
    from unnest(v_pool) as pool(id)
    left join lateral (
      select
        case when count(*) filter (where status in ('present', 'absent', 'late')) > 0
          then round((count(*) filter (where status = 'present')
                      + count(*) filter (where status = 'late') * 0.5)
                     / count(*) filter (where status in ('present', 'absent', 'late'))::numeric * 100, 2)
          else null end as attendance_pct
      from _student_attendance_rows(pool.id) r
      where r.subject_id in (
        select sse.subject_id from student_subject_enrollments sse where sse.student_id = pool.id
      )
      and (p_subject_ids is null or r.subject_id = any(p_subject_ids))
      and (p_term is null or r.term = p_term)
    ) att on true
    left join lateral (
      select
        case when count(distinct m.id) > 0
          then round(count(distinct smr.module_id)::numeric / count(distinct m.id) * 100, 2)
          else null end as module_pct
      from student_subject_enrollments sse
      join modules m on m.subject_id = sse.subject_id and m.is_published = true
      left join student_module_reads smr on smr.module_id = m.id and smr.student_id = pool.id
      where sse.student_id = pool.id
        and (p_subject_ids is null or sse.subject_id = any(p_subject_ids))
        and (p_term is null or m.term = p_term)
    ) modc on true
  )
  select jsonb_build_object(
    'percentile', (
      select case when count(*) = 0 then null
        else round(100.0 * count(*) filter (
               where s.engagement_score < (select engagement_score from scored where student_id = p_student_id)
             ) / count(*))
      end
      from scored s where s.student_id <> p_student_id
    ),
    'engagement_score', (select engagement_score from scored where student_id = p_student_id),
    'my_attendance_rate', (select attendance_pct from scored where student_id = p_student_id),
    'my_module_completion', (select module_pct from scored where student_id = p_student_id),
    'peer_count', (select count(*) from scored where student_id <> p_student_id)
  )
  into v_result;

  return v_result;
end;
$function$

CREATE OR REPLACE FUNCTION public.get_score_vs_class_average(p_student_id integer, p_subject_ids integer[] DEFAULT NULL::integer[], p_term character varying DEFAULT NULL::character varying)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_caller_student_id integer := auth_student_id();
  v_subject_ids integer[];
  v_result jsonb;
begin
  if not is_admin() and (v_caller_student_id is null or v_caller_student_id <> p_student_id) then
    raise exception 'Not authorized' using errcode = '42501';
  end if;

  if p_subject_ids is not null then
    v_subject_ids := p_subject_ids;
  else
    select coalesce(array_agg(subject_id), '{}') into v_subject_ids
    from student_subject_enrollments where student_id = p_student_id;
  end if;

  if v_subject_ids = '{}' then
    return jsonb_build_object('data', '[]'::jsonb);
  end if;

  select coalesce(jsonb_agg(
    jsonb_build_object(
      'activity_name', a.title,
      'my_score_pct', mine.pct,
      'class_avg_pct', round(peer.avg_pct, 1)
    ) order by a.due_date nulls last, a.created_at
  ), '[]'::jsonb)
  into v_result
  from activities a
  left join lateral (
    select round((s.score::numeric / s.max_score) * 100, 1) as pct
    from activity_submissions s
    where s.activity_id = a.id and s.student_id = p_student_id
      and s.is_graded = true and s.score is not null and s.max_score > 0
    limit 1
  ) mine on true
  cross join lateral (
    select avg((s2.score::numeric / s2.max_score) * 100) as avg_pct
    from activity_submissions s2
    join student_subject_enrollments sse2
      on sse2.student_id = s2.student_id and sse2.subject_id = a.subject_id
    where s2.activity_id = a.id
      and s2.is_graded = true and s2.score is not null and s2.max_score > 0
  ) peer
  where a.subject_id = any(v_subject_ids)
    and a.is_published = true
    and (p_term is null or a.term = p_term)
    and peer.avg_pct is not null;

  return jsonb_build_object('data', v_result);
end;
$function$

CREATE OR REPLACE FUNCTION public.get_student_attendance_calendar(p_student_id integer, p_subject_id integer DEFAULT NULL::integer, p_year integer DEFAULT NULL::integer, p_month integer DEFAULT NULL::integer, p_term character varying DEFAULT NULL::character varying)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
declare
  v_caller_student_id integer := auth_student_id();
  v_calendar jsonb;
  v_summary jsonb;
begin
  if not is_admin() and (v_caller_student_id is null or v_caller_student_id <> p_student_id) then
    raise exception 'Not authorized' using errcode = '42501';
  end if;

  select coalesce(jsonb_object_agg(to_char(session_date, 'YYYY-MM-DD'), status), '{}'::jsonb)
  into v_calendar
  from _student_attendance_rows(p_student_id)
  where (p_subject_id is null or subject_id = p_subject_id)
    and (p_year is null or extract(year from session_date) = p_year)
    and (p_month is null or extract(month from session_date) = p_month)
    and (p_term is null or term = p_term);

  select jsonb_build_object(
    'present', count(*) filter (where status = 'present'),
    'absent',  count(*) filter (where status = 'absent'),
    'late',    count(*) filter (where status = 'late'),
    'excused', count(*) filter (where status = 'excused')
  )
  into v_summary
  from _student_attendance_rows(p_student_id)
  where (p_subject_id is null or subject_id = p_subject_id)
    and (p_year is null or extract(year from session_date) = p_year)
    and (p_month is null or extract(month from session_date) = p_month)
    and (p_term is null or term = p_term);

  return jsonb_build_object('calendar', v_calendar, 'summary', v_summary);
end;
$function$


